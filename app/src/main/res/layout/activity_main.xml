<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">

    <it.snel.melamur.map.MapView
        android:id="@+id/map"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- top: search bar, then MAP / PLAN / MISC, then (while searching) results -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/mm_black" android:orientation="vertical"
        android:padding="8dp">

        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:background="@drawable/panel_bg" android:hint="@string/search_hint"
            android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1"
            android:paddingHorizontal="14dp" android:textColor="@color/mm_white"
            android:textColorHint="@color/mm_grey" android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/tabMap" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/tab_map" />
            <Button android:id="@+id/tabPlan" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/tab_plan" />
            <Button android:id="@+id/tabMisc" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="44dp"
                android:layout_weight="1" android:text="@string/tab_misc" />
        </LinearLayout>

        <ListView
            android:id="@+id/searchResults"
            android:layout_width="match_parent" android:layout_height="320dp"
            android:layout_marginTop="6dp" android:background="@color/mm_panel"
            android:visibility="gone" />
    </LinearLayout>

    <Button android:id="@+id/center"
        android:layout_width="56dp" android:layout_height="56dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="16dp" android:layout_marginBottom="150dp"
        android:background="@drawable/fab_bg" android:text="@string/center"
        android:textColor="@color/mm_white" android:textSize="24sp" />

    <LinearLayout android:id="@+id/panel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:layout_margin="10dp"
        android:background="@drawable/panel_bg" android:orientation="vertical"
        android:padding="12dp">
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/mm_grey"
            android:textSize="13sp" />
        <TextView android:id="@+id/nextStop" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/mm_white"
            android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/destination" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="@color/mm_red"
            android:textSize="15sp" />
        <TextView android:id="@+id/alert" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:background="@color/mm_red"
            android:padding="8dp" android:textColor="@color/mm_white"
            android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
