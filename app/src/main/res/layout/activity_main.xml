<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/mm_black" android:orientation="vertical">

    <!-- top: mode selector (Explore/Navigate), then search (Explore) or planner (Navigate), then results -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="8dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/tabExplore" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="42dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:text="@string/tab_explore" />
            <Button android:id="@+id/tabNavigate" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="42dp"
                android:layout_weight="1" android:text="@string/tab_navigate" />
            <ImageButton android:id="@+id/tabMisc"
                android:layout_width="42dp" android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:background="@android:color/transparent" android:scaleType="centerInside"
                android:src="@drawable/ic_menu" android:contentDescription="@string/cd_menu" />
        </LinearLayout>

        <!-- Explore: one search bar -->
        <EditText
            android:id="@+id/searchBar"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/panel_bg" android:hint="@string/search_hint"
            android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1"
            android:paddingHorizontal="14dp" android:textColor="@color/mm_white"
            android:textColorHint="@color/mm_grey" android:textSize="16sp" />

        <!-- Navigate: start + destination (with swap), then time + plan -->
        <LinearLayout android:id="@+id/navInputs"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical">
                    <EditText android:id="@+id/startInput"
                        android:layout_width="match_parent" android:layout_height="46dp"
                        android:background="@drawable/panel_bg" android:hint="@string/planner_choose_from"
                        android:inputType="text" android:maxLines="1" android:paddingHorizontal="14dp"
                        android:textColor="@color/mm_white" android:textColorHint="@color/mm_grey" android:textSize="16sp" />
                    <EditText android:id="@+id/endInput"
                        android:layout_width="match_parent" android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/panel_bg" android:hint="@string/planner_choose_to"
                        android:inputType="text" android:maxLines="1" android:paddingHorizontal="14dp"
                        android:textColor="@color/mm_white" android:textColorHint="@color/mm_grey" android:textSize="16sp" />
                </LinearLayout>
                <Button android:id="@+id/swapEnds" style="@style/MmButton"
                    android:layout_width="48dp" android:layout_height="match_parent"
                    android:layout_marginStart="6dp" android:text="@string/swap_ends"
                    android:contentDescription="@string/cd_swap" android:textSize="20sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="horizontal">
                <Button android:id="@+id/timeBtn" style="@style/MmButton"
                    android:layout_width="0dp" android:layout_height="44dp"
                    android:layout_weight="1" android:layout_marginEnd="6dp" />
                <!-- Plan only as wide as its label, so the time button gets the room -->
                <Button android:id="@+id/planBtn" style="@style/MmButton"
                    android:layout_width="wrap_content" android:layout_height="44dp"
                    android:minWidth="0dp" android:paddingHorizontal="18dp" android:text="@string/plan" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigate, options: browse the planned options, pick one -->
        <LinearLayout android:id="@+id/navOptions"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="vertical" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <Button android:id="@+id/optPrev" style="@style/MmButton"
                    android:layout_width="48dp" android:layout_height="46dp" android:minWidth="0dp"
                    android:text="◀" android:contentDescription="@string/cd_prev_option" />
                <TextView android:id="@+id/optInfo"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:gravity="center" android:paddingHorizontal="6dp"
                    android:textColor="@color/mm_white" android:textSize="15sp" />
                <Button android:id="@+id/optNext" style="@style/MmButton"
                    android:layout_width="48dp" android:layout_height="46dp" android:minWidth="0dp"
                    android:text="▶" android:contentDescription="@string/cd_next_option" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="horizontal">
                <Button android:id="@+id/optEdit" style="@style/MmButton"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:text="@string/nav_change" />
                <Button android:id="@+id/optSelect" style="@style/MmButton"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:text="@string/nav_select" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigate, an option selected: start interactive mode -->
        <LinearLayout android:id="@+id/navSelected"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/selInfo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:gravity="center" android:padding="4dp"
                android:textColor="@color/mm_white" android:textSize="15sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:orientation="horizontal">
                <Button android:id="@+id/selOther" style="@style/MmButton"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:text="@string/nav_other_options" />
                <Button android:id="@+id/selStart" style="@style/MmButton"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                    android:text="@string/nav_interactive" />
            </LinearLayout>
        </LinearLayout>

        <!-- Navigate, interactive: missed the bus / stop -->
        <LinearLayout android:id="@+id/navActive"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:orientation="horizontal" android:visibility="gone">
            <Button android:id="@+id/busLeft" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="2"
                android:layout_marginEnd="6dp" android:text="@string/nav_bus_left" android:textStyle="bold" />
            <Button android:id="@+id/navCancel" style="@style/MmButton"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:text="@string/nav_stop" />
        </LinearLayout>

        <ListView android:id="@+id/searchResults"
            android:layout_width="match_parent" android:layout_height="300dp"
            android:layout_marginTop="6dp" android:background="@color/mm_panel"
            android:visibility="gone" />
    </LinearLayout>

    <!-- content area: map or text -->
    <!-- pull from the left or right edge to switch between map and text -->
    <it.snel.melamur.EdgeSwipeLayout android:id="@+id/content"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <it.snel.melamur.map.MapView android:id="@+id/map"
            android:layout_width="match_parent" android:layout_height="match_parent" />

        <ScrollView android:id="@+id/textPanel"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/mm_black" android:visibility="gone">
            <LinearLayout android:id="@+id/textContent"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingVertical="14dp" android:paddingHorizontal="24dp" />
        </ScrollView>

        <!-- compass: top-left, only while the map is not north up; tap = north up -->
        <ImageButton android:id="@+id/compass"
            android:layout_width="44dp" android:layout_height="44dp"
            android:layout_gravity="top|start" android:layout_margin="12dp"
            android:background="@drawable/compass_bg" android:padding="8dp"
            android:scaleType="fitCenter" android:src="@drawable/ic_compass"
            android:contentDescription="@string/cd_compass" android:visibility="gone" />

        <!-- zoom in / out: top-right; hidden in text mode -->
        <LinearLayout android:id="@+id/zoomBox"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="top|end" android:layout_margin="12dp"
            android:orientation="vertical">
            <Button android:id="@+id/zoomIn"
                android:layout_width="44dp" android:layout_height="44dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/fab_bg" android:text="@string/zoom_in"
                android:contentDescription="@string/cd_zoom_in"
                android:textColor="@color/mm_white" android:textSize="24sp" />
            <Button android:id="@+id/zoomOut"
                android:layout_width="44dp" android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
                android:background="@drawable/fab_bg" android:text="@string/zoom_out"
                android:contentDescription="@string/cd_zoom_out"
                android:textColor="@color/mm_white" android:textSize="24sp" />
        </LinearLayout>

        <!-- line mode: zoom out to the whole line (offered, not done, when a line is picked on the map) -->
        <Button android:id="@+id/lineFit" style="@style/MmButton"
            android:layout_width="wrap_content" android:layout_height="44dp"
            android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="20dp"
            android:minWidth="0dp" android:paddingHorizontal="16dp"
            android:text="@string/line_fit" android:visibility="gone" />

        <!-- center-me: sits bottom-right, just above the Map/Text/Misc bar; hidden in text mode -->
        <Button android:id="@+id/center"
            android:layout_width="56dp" android:layout_height="56dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="16dp" android:layout_marginBottom="16dp"
            android:background="@drawable/fab_bg" android:text="@string/center"
            android:textColor="@color/mm_white" android:textSize="24sp" />

        <LinearLayout android:id="@+id/panel"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_margin="10dp"
            android:background="@drawable/panel_bg" android:orientation="vertical"
            android:padding="12dp" android:visibility="gone">
            <TextView android:id="@+id/status" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mm_grey" android:textSize="13sp" />
            <TextView android:id="@+id/nextStop" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mm_white"
                android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/destination" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="@color/mm_red" android:textSize="15sp" />
            <TextView android:id="@+id/alert" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="@color/mm_red"
                android:padding="8dp" android:textColor="@color/mm_white"
                android:textSize="18sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <!-- edge handles: show that the sides can be pulled; tap also switches -->
        <ImageView android:id="@+id/edgeLeft"
            android:layout_width="18dp" android:layout_height="64dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/edge_left" android:paddingEnd="2dp"
            android:scaleType="centerInside" android:contentDescription="@string/cd_switch_view" />
        <ImageView android:id="@+id/edgeRight"
            android:layout_width="18dp" android:layout_height="64dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/edge_right" android:paddingStart="2dp"
            android:scaleType="centerInside" android:contentDescription="@string/cd_switch_view" />

        <!-- precalculation in progress (first start with a new database) -->
        <TextView android:id="@+id/precalcNote"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top" android:layout_marginTop="12dp"
            android:layout_marginHorizontal="64dp"
            android:background="@drawable/panel_bg" android:paddingHorizontal="14dp" android:paddingVertical="8dp"
            android:textColor="@color/mm_white" android:textSize="13sp" android:visibility="gone" />

        <!-- one-line hint about pulling the edges -->
        <TextView android:id="@+id/swipeHint"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom" android:layout_marginBottom="84dp"
            android:background="@drawable/panel_bg" android:paddingHorizontal="14dp" android:paddingVertical="8dp"
            android:textColor="@color/mm_white" android:textSize="14sp" android:visibility="gone" />
    </it.snel.melamur.EdgeSwipeLayout>
</LinearLayout>
