<?xml version="1.0" encoding="utf-8"?>
<!-- Red outline of a bus travelling LEFT (Malta drives on the left): the front
     is the raked end on the left, a chevron points the way, and motion lines
     trail on the right. Thin strokes, no doors or windows. Deliberately unlike
     the round green Tallinja mark. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <!-- body: flat rear on the right, raked nose on the left (front) -->
    <path android:strokeColor="#E10600" android:strokeWidth="1.4"
        android:strokeLineJoin="round" android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M40,15 L14,15 L8,20 L8,31 L40,31 Z" />

    <!-- wheels -->
    <path android:strokeColor="#E10600" android:strokeWidth="1.1" android:fillColor="#00000000"
        android:pathData="M11.2,31 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0
                          M30.3,31 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0" />

    <!-- direction chevron at the nose, pointing left -->
    <path android:strokeColor="#E10600" android:strokeWidth="1.4"
        android:strokeLineJoin="round" android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M6,21 L2.5,25 L6,29" />

    <!-- motion lines trailing on the right -->
    <path android:strokeColor="#E10600" android:strokeWidth="1.2" android:strokeLineCap="round"
        android:pathData="M42.5,19 L46.5,19 M43.5,24 L47,24 M42.5,29 L46.5,29" />
</vector>
