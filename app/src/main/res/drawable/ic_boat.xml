<?xml version="1.0" encoding="utf-8"?>
<!-- Red outline of a ferry travelling LEFT, in the same thin-line style as the
     bus (ic_logo): hull, cabin, funnel, a waterline wave, and motion lines
     trailing at the back. No fill. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp" android:height="48dp"
    android:viewportWidth="48" android:viewportHeight="48">

    <!-- hull: bow (left), deck, stern, curved bottom back to the bow -->
    <path android:strokeColor="#EE0000" android:strokeWidth="1.3"
        android:strokeLineJoin="round" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M3,24 L13,21 L39,21 L41.5,26.5 C33,33 12,33 3,24 Z" />

    <!-- cabin (rounded top) and funnel -->
    <path android:strokeColor="#EE0000" android:strokeWidth="1.1"
        android:strokeLineJoin="round" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M17,21 L17,15 Q17,13 19,13 L29,13 Q31,13 31,15 L31,21 M34,21 L34,14.5 L37,14.5 L37,21" />

    <!-- waterline wave -->
    <path android:strokeColor="#EE0000" android:strokeWidth="1.1" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M3,32 Q7,33.2 11,32 Q15,30.8 19,32 Q23,33.2 27,32 Q31,30.8 35,32 Q39,33.2 41,32" />

    <!-- motion lines at the back -->
    <path android:strokeColor="#EE0000" android:strokeWidth="1.1" android:strokeLineCap="round" android:fillColor="#00000000"
        android:pathData="M43.5,18 L47,18 M44.5,22.5 L47.6,22.5 M43.5,27 L47,27" />
</vector>
